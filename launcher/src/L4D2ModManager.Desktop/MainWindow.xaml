<Window x:Class="L4D2ModManager.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Title="L4D2 Modpack Manager" Width="1180" Height="760"
        MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen"
        Foreground="White" FontFamily="Segoe UI">
  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#25110F" Offset="0" />
      <GradientStop Color="#0A0E13" Offset="0.48" />
      <GradientStop Color="#101820" Offset="1" />
    </LinearGradientBrush>
  </Window.Background>
  <Grid>
    <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.28" />
    <Rectangle Fill="#76000000" />
    <Grid Margin="34">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,24">
        <StackPanel>
          <TextBlock Text="L4D2 MODPACK" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="MANAGER" FontSize="38" FontWeight="Black" />
          <TextBlock Text="Sincronização segura, incremental e sem tocar nos seus mods pessoais." Foreground="{StaticResource MutedBrush}" FontSize="14" />
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
          <TextBlock Text="VERSÃO DISPONÍVEL" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" FontSize="11" />
          <TextBlock Text="{Binding AvailableVersion}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="18" Margin="0,0,0,18">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="PASTA DO JOGO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="{Binding GamePath}" FontSize="15" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="Selecionar pasta" Command="{Binding SelectPathCommand}" Background="#34404C" Margin="16,0,0,0" />
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,18,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="MODS DO PACOTE" FontSize="13" FontWeight="Bold" Margin="8,5,0,12" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Focusable" Value="False"/></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#A51C232C" CornerRadius="10" Padding="10">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="100" Height="64" CornerRadius="7" Background="#27313B" ClipToBounds="True">
                        <Image Source="{Binding PreviewUrl}" Stretch="UniformToFill" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,1">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12" MaxHeight="34" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Id, StringFormat=Workshop #{0}}" Foreground="#758393" FontSize="11" Margin="0,3,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding DisplaySize}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24">
          <StackPanel>
            <TextBlock Text="STATUS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="{Binding Status}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,22" />
            <Grid Margin="0,0,0,20">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="INSTALADA" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding InstalledVersion}" FontSize="18" FontWeight="Bold"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="MODS" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock Text="{Binding ModCount}" FontSize="18" FontWeight="Bold"/></StackPanel>
            </Grid>
            <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" Background="#29313A" BorderThickness="0" Margin="0,0,0,12" />
            <TextBlock Text="{Binding PlanSummary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
            <Button Content="VERIFICAR ATUALIZAÇÕES" Command="{Binding RefreshCommand}" Background="#34404C" Margin="0,0,0,10" />
            <Button Content="ATUALIZAR MODPACK" Command="{Binding UpdateCommand}" />
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock Grid.Row="3" Text="{Binding Footer}" Foreground="#778390" FontSize="11" Margin="4,16,0,0" />
    </Grid>
  </Grid>
</Window>
