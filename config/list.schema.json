{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/l4d2-modpack-list.schema.json",
  "title": "L4D2 Modpack List",
  "type": "object",
  "additionalProperties": false,
  "required": ["game", "mods"],
  "properties": {
    "game": { "const": 550 },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "redistributionAuthorized": { "type": "boolean", "default": false }
        }
      }
    }
  }
}

